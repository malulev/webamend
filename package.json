{
  "name": "website-ai-auto-builder",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "dev:session": "tsx scripts/dev-session.ts",
    "enroll:link": "tsx scripts/enroll-link.ts",
    "test:slotd": "python3 -m unittest discover -s ops/slotd -p 'test_*.py'",
    "test:ops": "bash tests/ops/set-env.test.sh",
    "stress:slotd": "python3 ops/slotd/stress.py"
  },
  "dependencies": {
    "dockerode": "^4.0.9",
    "minimatch": "^10.2.6",
    "next": "^15.5.25",
    "nodemailer": "^10.0.0",
    "octokit": "^5.0.5",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "uuid": "^11.1.1"
  }
}
