# /etc/webamend/monitoring.env — 0600 root:root, never in a client .env.
#
# A client user can read their own .env; these tokens are host-wide authority
# over the whole fleet's telemetry, so they live where only root can read them.

# From Grafana Cloud: Connections -> Prometheus / Loki -> the push URL, the
# numeric user id, and one access policy token with metrics:write, logs:write.
GRAFANA_PROM_URL=https://prometheus-prod-XX-region.grafana.net/api/prom/push
GRAFANA_PROM_USER=000000
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=000000
GRAFANA_CLOUD_TOKEN=

# The dead-man's switch. Create a check with a 15 minute period and a 15
# minute grace, then paste its ping URL here. This is the only monitor that
# can fire when the box, the network or Alloy itself is gone.
HEARTBEAT_URL=
