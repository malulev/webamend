// Grafana Alloy: the only resident monitoring process on the host.
//
// ---------------------------------------------------------------------------
// LABEL DISCIPLINE — read before adding anything
// ---------------------------------------------------------------------------
// Only `job`, `slug`, `host`, `unit`, `level`, `event` and `stream` may be
// labels. `filename` is dropped below — it arrives on its own and is not one.
//
// Everything else stays a *field* inside the JSON line, parsed at query time
// with `| json`, which in Loki costs nothing. `requestId`, `conversationNumber`,
// `commitSha` and `previewUrl` are unbounded: promoting any one of them to a
// label burns the free tier's series allowance in a day and cannot be undone
// retroactively. `errorCode` is the one tempting exception that is genuinely
// safe — it is a closed 14-value union in src/types/index.ts — and it is
// promoted below for exactly that reason.
// ---------------------------------------------------------------------------

logging {
  level = "warn"
}

// --- host metrics ----------------------------------------------------------
//
// node_exporter, built in, so there is no second process. Only the collectors
// that say something about this box: the default set is roughly 2000 series
// here, most of it about hardware a VPS does not have, and active series is
// the scarce resource on the free tier.
prometheus.exporter.unix "host" {
  set_collectors = [
    "cpu", "meminfo", "loadavg", "filesystem", "diskstats",
    "netdev", "systemd", "uname", "time", "textfile", "pressure",
  ]

  filesystem {
    // Rootless Docker keeps each client's data-root under their home, and one
    // series per container overlay layer is the textbook cardinality
    // explosion.
    mount_points_exclude = "^/(dev|proc|sys|run|var/lib/docker/.+|home/[^/]+/\\.local/share/docker/.+)($|/)"
  }

  textfile {
    // Written by ops/probe.sh: the per-client facts no generic exporter knows,
    // including webamend_clients_total, the host's agent ceiling.
    directory = "/var/lib/node_exporter/textfile"
  }
}

// Alloy's own footprint, so the RAM budget in MONITORING.md is provable rather
// than asserted.
prometheus.exporter.self "alloy" {}

prometheus.scrape "host" {
  targets = array.concat(
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.self.alloy.targets,
  )
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  // One Grafana Cloud stack usually serves more than one project — the free
  // tier allows exactly one. `webamend_*` is already a unique prefix, but
  // `node_cpu_seconds_total` from this host is indistinguishable from the same
  // metric shipped by anything else you own. This stamps every series, so a
  // query, a dashboard variable or an alert rule can always say which project
  // it means.
  external_labels = {
    project = "webamend",
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
    // Bounded deliberately: the write-ahead log sits on the same 38 GB
    // filesystem as /srv/webamend and every client's image store, so an outage at
    // the far end must not become a disk outage here.
    queue_config {
      capacity              = 2500
      max_samples_per_send  = 500
    }
  }
  wal {
    truncate_frequency = "2h"
  }
}

// --- application logs ------------------------------------------------------
//
// Alloy is made to run as root by the systemd drop-in install-monitoring.sh
// writes, so it can read each client's container logs straight off disk —
// client homes are 0750 and the packaged `alloy` user cannot traverse them.
// If these paths ever come back empty while metrics still flow, that is the
// first thing to check.
//
// Deliberately NOT via discovery.docker against every
// /run/user/<uid>/docker.sock: pointing one root process at every client's
// daemon socket rebuilds exactly the blast radius that one-rootless-daemon-
// per-user exists to remove.
local.file_match "containers" {
  path_targets = [{
    __path__ = "/home/*/.local/share/docker/containers/*/*-json.log",
    job      = "webamend",
  }]
}

// The client slug comes from the path, at discovery time — not from a regex
// stage in the pipeline. A processing stage reads the *extracted map*, and the
// filename is a target label rather than an extracted field, so deriving it
// there does not work.
discovery.relabel "containers" {
  targets = local.file_match.containers.targets

  rule {
    source_labels = ["__path__"]
    regex         = "/home/([^/]+)/.*"
    target_label  = "slug"
    replacement   = "$1"
  }
}

loki.source.file "containers" {
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.webamend.receiver]
}

loki.process "webamend" {
  forward_to = [loki.write.grafana.receiver]

  // Docker's json-file envelope first; the application's own line is inside.
  stage.json {
    expressions = { output = "log", stream = "stream" }
  }
  stage.output {
    source = "output"
  }

  // Keep only the structured envelope. This glob also matches AGENT container
  // logs — raw model output taken over a client's private working tree, which
  // must never leave this box. Allowlisting the envelope is what excludes it:
  // an agent line carries no `event` field, so the extraction below leaves it
  // empty and the drop stage removes the line.
  //
  // `source` + `value` together mean "drop when this extracted field equals
  // this". Do not add `expression` as well — it is the other, mutually
  // exclusive, way to spell the same stage.
  // A line filter, not a field comparison. `stage.drop` with source+value
  // drops when the field EQUALS the value — and a line that is not ours has no
  // `event` key at all, so the field is ABSENT, the stage skips, and the line
  // survives. That distinction once put an agent's whole working transcript,
  // including the contents of a client's private files, into an external log
  // service. Matching the raw line has no absent case.
  //
  // This is the only thing keeping the transcript off the wire. Agent
  // containers cannot use the `none` log driver — `attach` stops delivering
  // output on this daemon when they do (src/lib/runner/docker.ts) — so the
  // json-file is on disk and this glob does find it.
  stage.match {
    selector = "{job=\"webamend\"} !~ \".*\\\"event\\\":.*\""
    action   = "drop"

    drop_counter_reason = "not_a_webamend_event"
  }

  // The one application line that carries agent output: the agent's last
  // words when a run fails (`agent.run_failed_detail`, src/lib/jobs/run.ts).
  // It exists so `docker logs` explains a failure on the box; it is dropped
  // here for the same reason the transcript is. Its counted twin,
  // `agent.run_failed`, carries no detail and ships. A line match again, for
  // the reason above.
  stage.match {
    selector = "{job=\"webamend\"} |= \"\\\"event\\\":\\\"agent.run_failed_detail\\\"\""
    action   = "drop"

    drop_counter_reason = "agent_output"
  }

  stage.json {
    expressions = { ts = "ts", level = "level", event = "event" }
  }

  // `slug` is already a target label from discovery.relabel above.
  stage.labels {
    values = { level = "level", event = "event" }
  }

  // `loki.source.file` attaches `filename` to every entry by itself, and the
  // value holds the container ID — so each `ops/release.sh` recreates the app
  // container, mints a new ID, and starts a brand new stream that never ends.
  // A slow leak of the free tier's series allowance, and visible long before
  // that: a dashboard panel that unwraps a field without an outer aggregation
  // silently returns one series per container generation.
  stage.label_drop {
    values = ["filename"]
  }

  // Same reason as external_labels on the metrics side: one stack, several
  // projects. `host` is the log-side counterpart of the `instance` label Alloy
  // puts on every metric by itself — without it, a second box's lines are
  // indistinguishable from this one's.
  stage.static_labels {
    values = { project = "webamend", host = constants.hostname }
  }
  stage.timestamp {
    source = "ts"
    format = "RFC3339"
  }
}

loki.write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// --- host journal ----------------------------------------------------------
//
// Caddy, dockerd, sshd and the per-client rootless daemons.
//
// Caddy access logs are NOT here, whatever you may have read: Caddy v2 emits
// them only where a site block carries a `log` directive, and /etc/caddy/
// Caddyfile is two bare `reverse_proxy` lines (verified 2026-09-15 —
// `journalctl -u caddy` is empty). Adding `log { output stderr }` to each site
// buys per-client HTTP status, latency and 5xx rate for no application code;
// until then nothing in this stack sees the reverse proxy's view of a request.
loki.source.journal "host" {
  forward_to = [loki.write.grafana.receiver]
  // Namespaced deliberately: a bare job="systemd" collides with every other
  // host that ships a journal to the same stack, and the two sets are
  // indistinguishable once mixed.
  labels     = { job = "webamend-host", project = "webamend", host = constants.hostname }
  relabel_rules = loki.relabel.journal.rules
  max_age    = "12h"
}

loki.relabel "journal" {
  forward_to = []
  // Only the unit. Auto-promoting __journal__pid, _CMDLINE or _EXE is the
  // journald cardinality trap: one series per process ever started.
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__systemd_user_unit"]
    target_label  = "user_unit"
  }
}
