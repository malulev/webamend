{
  "title": "Webamend \u2014 health",
  "uid": "webamend-health",
  "tags": [
    "webamend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "slug",
        "label": "Client",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": "label_values(webamend_client_app_up{project=\"webamend\"}, slug)",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "sort": 1
      },
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Client editable",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webamend_client_health_ok{project=\"webamend\", slug=~\"$slug\"}",
          "legendFormat": "{{slug}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Client can reach GitHub + Netlify",
      "id": 2,
      "description": "Deep readiness. Goes red on an expired credential while the app still serves 200.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webamend_client_ready_ok{project=\"webamend\", slug=~\"$slug\"}",
          "legendFormat": "{{slug}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DEGRADED",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Release in progress",
      "id": 3,
      "description": "ops/release.sh touches /var/lib/webamend/maintenance. Red panels above are expected while this is 1.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webamend_maintenance{project=\"webamend\"}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "ROLLING",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Probe age",
      "id": 4,
      "description": "Seconds since ops/probe.sh last completed. Above ~120s the whole dashboard is stale, whatever it shows.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - webamend_probe_last_success_timestamp_seconds{project=\"webamend\"}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Memory available vs projected agent demand",
      "id": 5,
      "description": "No swap on this box. The demand line is what the admission daemon admits at once (webamend_slots_capacity; before it is installed, the client count) times the ~400 MB a measured agent run holds. When available crosses below it, the ceiling is wrong for this host.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{project=\"webamend\"}",
          "legendFormat": "available"
        },
        {
          "refId": "B",
          "expr": "(webamend_slots_capacity{project=\"webamend\"} or webamend_clients_total{project=\"webamend\"}) * 419430400",
          "legendFormat": "agent demand at capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Disk / used",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{project=\"webamend\", mountpoint=\"/\"} / node_filesystem_size_bytes{project=\"webamend\", mountpoint=\"/\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Load average",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{project=\"webamend\"}",
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "expr": "node_load15{project=\"webamend\"}",
          "legendFormat": "15m"
        },
        {
          "refId": "C",
          "expr": "count(count by (cpu) (node_cpu_seconds_total{project=\"webamend\"}))",
          "legendFormat": "cores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Agent containers running per client",
      "id": 8,
      "description": "Each client runs at most one agent at a time (the site lock), so a client pinned at 1 is a client whose next request waits on the lock. Total across clients is the host's live agent load.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webamend_client_agents_running{project=\"webamend\", slug=~\"$slug\"}",
          "legendFormat": "{{slug}} running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Deployed version per client",
      "id": 9,
      "description": "More than one sha across clients means a release.sh run stopped half way.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webamend_client_info{project=\"webamend\", slug=~\"$slug\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "project": true,
              "instance": true
            }
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "Errors and warnings, live",
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"webamend\", project=\"webamend\", slug=~\"$slug\", level=~\"error|warn\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}