{
  "title": "Webamend \u2014 requests",
  "uid": "webamend-requests",
  "tags": [
    "webamend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "slug",
        "label": "Client",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": "label_values({job=\"webamend\"}, slug)",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "sort": 1
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Failure ratio, 24h",
      "id": 1,
      "description": "The number that says whether the product works. The app can be up, the heartbeat green, and this at 100%.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | outcome=\"failed\" [24h])) / sum(count_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json [24h]))"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Requests, 24h",
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (slug) (count_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json [24h]))",
          "legendFormat": "{{slug}}"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Spend, 24h",
      "id": 3,
      "description": "The aggregate the per-request cost ceiling cannot see.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (slug) (sum_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap costUsd [24h]))",
          "legendFormat": "{{slug}}"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Slot wait p90, 24h",
      "id": 4,
      "description": "Capacity pressure before it becomes too_busy.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "quantile_over_time(0.9, {job=\"webamend\", event=\"slot.waited\", slug=~\"$slug\"} | json | unwrap waitedMs [24h]) by (slug)",
          "legendFormat": "{{slug}}"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Outcomes",
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (count_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json [$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Why requests ended, 7d",
      "id": 6,
      "description": "The 14-value errorCode union. blocked_by_policy is client friction; internal_error and the model_* codes are yours.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (errorCode) (count_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | errorCode != \"\" [7d]))",
          "legendFormat": "{{errorCode}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Duration p50 / p95",
      "id": 7,
      "description": "What the client actually waited.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap durationMs [$__auto]) by (slug)",
          "legendFormat": "{{slug}} p50"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap durationMs [$__auto]) by (slug)",
          "legendFormat": "{{slug}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 6,
            "lineWidth": 2,
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Where the time went (mean)",
      "id": 8,
      "description": "preparing is clone + checkout, running is the model, building is Netlify. Each query aggregates by slug: unwrap without an outer aggregation returns one series per stream, which stacks the same stage into the bar more than once.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (slug) (avg_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap preparingMs [$__auto]))",
          "legendFormat": "{{slug}} preparing"
        },
        {
          "refId": "B",
          "expr": "avg by (slug) (avg_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap queuedMs [$__auto]))",
          "legendFormat": "{{slug}} queued"
        },
        {
          "refId": "C",
          "expr": "avg by (slug) (avg_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap runningMs [$__auto]))",
          "legendFormat": "{{slug}} running"
        },
        {
          "refId": "D",
          "expr": "avg by (slug) (avg_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap gatingMs [$__auto]))",
          "legendFormat": "{{slug}} gating"
        },
        {
          "refId": "E",
          "expr": "avg by (slug) (avg_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap pushingMs [$__auto]))",
          "legendFormat": "{{slug}} pushing"
        },
        {
          "refId": "F",
          "expr": "avg by (slug) (avg_over_time({job=\"webamend\", event=\"request.ended\", slug=~\"$slug\"} | json | unwrap buildingMs [$__auto]))",
          "legendFormat": "{{slug}} building"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 75,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Published vs undone",
      "id": 9,
      "description": "A preview never published means the agent's output was not good enough. An undo means it was published and then rejected \u2014 worse.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (count_over_time({job=\"webamend\", event=\"publication.ended\", slug=~\"$slug\"} | json [$__auto]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Failures, with the reason",
      "id": 10,
      "description": "provider.failed carries the provider's own sentence. request.failed carries a stack. The agent's own output never leaves the box \u2014 read it with docker logs.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"webamend\", slug=~\"$slug\", event=~\"request.failed|provider.failed|agent.run_failed|request.lock_leak|publication.failed\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}